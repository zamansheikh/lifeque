<?xml version="1.0" encoding="utf-8"?>
<!-- Static mock of the slim bar widget for the launcher's picker. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_bg_slim"
    android:paddingLeft="14dp"
    android:paddingRight="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/noto_serif_bengali"
                android:text="@string/preview_isha"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="@font/noto_serif_bengali"
                android:text="@string/preview_slim_range"
        android:textColor="#CCFFFFFF"
        android:textSize="11sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/noto_serif_bengali"
                android:text="@string/preview_countdown"
        android:textColor="#F5D27A"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/noto_serif_bengali"
                android:text="@string/preview_waqt_ends"
        android:textColor="#99FFFFFF"
        android:textSize="9sp" />
</LinearLayout>
