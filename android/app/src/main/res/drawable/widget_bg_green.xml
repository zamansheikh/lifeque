<?xml version="1.0" encoding="utf-8"?>
<!-- Mirrors PrayerWidgetUI's gradient so the strips left by
     scaleType="fitCenter" are indistinguishable from the card itself. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#FF1E7A50"
        android:centerColor="#FF146C43"
        android:endColor="#FF0E4A30"
        android:type="linear" />
    <corners android:radius="20dp" />
</shape>
