<?xml version="1.0" encoding="utf-8"?>
<!-- The day track in the day-map preview: dawn through dusk, left to right. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="0"
        android:startColor="#FFF5D27A"
        android:centerColor="#FF4FB286"
        android:endColor="#FFF08A5D"
        android:type="linear" />
    <corners android:radius="6dp" />
</shape>
